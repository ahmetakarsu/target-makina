---
import BaseLayout from '../layouts/BaseLayout.astro';
import OptimizedImage from '../components/OptimizedImage.astro';

const title = "TARGET MAKİNA | CNC İşleme, Hassas Üretim ve Endüstriyel Makina Çözümleri";
const description = "TARGET MAKİNA - İzmir merkezli CNC frezeleme, CNC tornalama, hassas işleme ve yüzey kaplama hizmetleri. Hızlı prototiplemeden seri üretime endüstriyel çözümler. Teklif almak için hemen arayın: 0544 356 39 72";
const keywords = "CNC işleme, CNC frezeleme, CNC tornalama, hassas üretim, endüstriyel makina, prototip üretim, metal işleme, yüzey kaplama, Target Makina, İzmir CNC, seri üretim, kalite kontrol, ISO 9001, Telerezyon, İzmir Telerezyon, CNC 5 Eksen, Mastar İmalatı, Fikstür İmalatı, Talaşlı İmalat, Hassas Talaşlı imalat";
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <Fragment slot="head">
    <link rel="stylesheet" href="/assets/tpl-common/common/css/swiper7.css">
    <link rel="stylesheet" href="/assets/tpl-common/common/css/jquery.fancybox.css">
    <link rel="stylesheet" href="/assets/tpl-common/common/css/form.css">
    <link rel="stylesheet" href="/assets/inst/3579/4204/482129/sections/huake_banner_1761527394356428/index.css">
    <link rel="stylesheet" href="/assets/inst/3579/4204/482129/sections/taskoit_service_1760495813395700/index.css">
    <link rel="stylesheet" href="/assets/inst/3579/4204/482129/sections/sutong_pic_text2_1760403555313057/index.css">
    <link rel="stylesheet" href="/assets/inst/3579/4204/482129/sections/bobo_company_intro_1760403430795121/index.css">
    <link rel="stylesheet" href="/assets/inst/3579/4204/482129/sections/bobo_indicator_1760403448459444/index.css">
    <link rel="stylesheet" href="/assets/inst/3579/4204/482129/sections/song_aboutus_1762830186214216/index.css">
    <link rel="stylesheet" href="/assets/inst/3579/4204/482129/sections/san_home_choose_1760402498909976/index.css">
    <link rel="stylesheet" href="/assets/inst/3579/4204/482129/sections/bobo_certificate_1760403740453223/index.css">
    <link rel="stylesheet" href="/assets/inst/3579/4204/482129/sections/sung_news_1760403655895355/index.css">
    <style is:global>
      .sutong-pic-text2 {
        background: #f7f8fa;
      }

      .sutong-pic-text2 .container,
      .san-home-choose .container {
        width: min(1180px, calc(100% - 96px));
        max-width: 1180px;
      }

      .sutong-pic-text2 .top {
        align-items: flex-end;
        gap: 24px;
      }

      .sutong-pic-text2 .more {
        height: 48px;
        padding: 0 26px;
        border-color: rgba(201, 55, 21, 0.24);
        border-radius: 8px;
        background: #fff;
        color: #c93715;
        box-shadow: 0 12px 28px rgba(16, 24, 40, 0.06);
      }

      .sutong-pic-text2 .more span {
        width: 8px;
        height: 8px;
        border-radius: 2px;
        margin-right: 7px;
      }

      .sutong-pic-text2 .more span:last-child {
        margin-right: 16px;
      }

      .sutong-pic-text2 ul {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 24px;
        margin: 50px 0 0;
      }

      .sutong-pic-text2 ul li {
        width: auto;
        padding: 0;
      }

      .sutong-pic-text2 ul li::before,
      .sutong-pic-text2 ul li::after,
      .sutong-pic-text2 ul li .dot {
        display: none !important;
      }

      .sutong-pic-text2 ul li .box {
        height: 100%;
        padding: 18px;
        text-align: left;
        background: #fff;
        border: 1px solid #e8edf2;
        border-bottom: 1px solid #e8edf2;
        border-radius: 8px;
        box-shadow: 0 18px 45px rgba(16, 24, 40, 0.07);
        transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
      }

      .sutong-pic-text2 ul li:hover .box {
        transform: translateY(-6px);
        border-color: rgba(201, 55, 21, 0.32);
        box-shadow: 0 24px 60px rgba(16, 24, 40, 0.11);
      }

      .sutong-pic-text2 ul li .box::after {
        display: none;
      }

      .sutong-pic-text2 ul li .ico {
        position: relative;
        width: 100%;
        height: 150px;
        overflow: hidden;
        display: block;
        border-radius: 8px;
        background: #eef2f6;
      }

      .sutong-pic-text2 ul li .ico::after {
        position: absolute;
        right: 12px;
        bottom: 12px;
        width: 42px;
        height: 42px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: #c93715;
        color: #fff;
        font-size: 13px;
        font-weight: 800;
        box-shadow: 0 10px 22px rgba(201, 55, 21, 0.28);
      }

      .sutong-pic-text2 ul li:nth-child(1) .ico::after { content: "01"; }
      .sutong-pic-text2 ul li:nth-child(2) .ico::after { content: "02"; }
      .sutong-pic-text2 ul li:nth-child(3) .ico::after { content: "03"; }
      .sutong-pic-text2 ul li:nth-child(4) .ico::after { content: "04"; }

      .sutong-pic-text2 ul li .ico img {
        width: 100%;
        height: 100%;
        max-width: none;
        max-height: none;
        object-fit: cover;
        filter: none;
        transition: transform 0.35s ease;
      }

      .sutong-pic-text2 ul li:hover .ico img {
        transform: scale(1.04);
      }

      .sutong-pic-text2 ul li h5 {
        margin: 20px 0 0;
        line-height: 1.25;
        color: #1d2733;
      }

      .sutong-pic-text2 ul li p {
        color: #5d6876;
      }

      .san-home-choose {
        background: #fff;
      }

      .san-home-choose .title {
        width: min(100%, 960px);
        margin-top: 0;
      }

      .san-home-choose .title p {
        max-width: 900px;
        color: #5d6876;
      }

      .san-home-choose .wpa {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 24px;
        margin-top: 38px;
      }

      .san-home-choose .lg-04 li,
      .san-home-choose .lg-04 li:nth-child(4n+1) {
        width: auto;
        margin-left: 0;
      }

      .san-home-choose ul li {
        overflow: hidden;
        padding: 0;
        background: #fff;
        border: 1px solid #e8edf2;
        border-bottom: 1px solid #e8edf2;
        border-radius: 8px;
        box-shadow: 0 18px 45px rgba(16, 24, 40, 0.07);
        transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
      }

      .san-home-choose ul li:hover {
        transform: translateY(-6px);
        border-color: rgba(201, 55, 21, 0.32);
        box-shadow: 0 24px 60px rgba(16, 24, 40, 0.11);
      }

      .san-home-choose ul li::after {
        display: none;
      }

      .san-home-choose ul li span {
        width: 100%;
        height: 156px;
        margin: 0;
        overflow: hidden;
        display: block;
        background: #eef2f6;
      }

      .san-home-choose ul li span img {
        width: 100%;
        height: 100%;
        max-width: none;
        max-height: none;
        object-fit: cover;
        filter: none;
        transition: transform 0.35s ease;
      }

      .san-home-choose ul li:hover span img {
        transform: scale(1.04);
      }

      .san-home-choose ul li h3 {
        min-height: auto;
        margin: 22px 22px 0;
        color: #1d2733;
        line-height: 1.3;
      }

      .san-home-choose ul li p {
        margin: 14px 22px 24px;
        color: #5d6876;
      }

      @media screen and (max-width: 992px) {
        .sutong-pic-text2 .container,
        .san-home-choose .container {
          width: 100%;
        }

        .sutong-pic-text2 ul,
        .san-home-choose .wpa {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .sutong-pic-text2 .top {
          display: block;
        }
      }

      @media screen and (max-width: 576px) {
        .sutong-pic-text2 ul,
        .san-home-choose .wpa {
          grid-template-columns: 1fr;
        }

        .sutong-pic-text2 ul {
          margin-top: 28px;
        }

        .sutong-pic-text2 ul li .ico,
        .san-home-choose ul li span {
          height: 180px;
        }
      }
    </style>
  </Fragment>

<div id="huake-banner" style="position: relative;">
<div class="swiper">
