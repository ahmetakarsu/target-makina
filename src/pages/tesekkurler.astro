---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Teşekkürler | TARGET MAKİNA" description="Mesajınız başarıyla alındı." robots="noindex, follow">
  <section class="thanks-page">
    <div class="thanks-card">
      <div class="thanks-mark" aria-hidden="true">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
      </div>
      <h1>Teşekkürler!</h1>
      <p>Teklif talebiniz başarıyla alınmıştır. İlgili ekibimiz en kısa sürede sizinle iletişime geçecektir.</p>
      <a href="/">Ana Sayfaya Dön</a>
    </div>
  </section>
</BaseLayout>

<style>
  .thanks-page {
    display: grid;
    min-height: 58vh;
    padding: 90px 16px;
    place-items: center;
    background: #f7f8fa;
  }

  .thanks-card {
    width: min(680px, 100%);
    padding: 44px 34px;
    text-align: center;
    background: #fff;
    border: 1px solid #e8edf2;
    border-radius: 8px;
    box-shadow: 0 18px 45px rgba(16, 24, 40, 0.08);
  }

  .thanks-mark {
    width: 68px;
    height: 68px;
    display: grid;
    margin: 0 auto 22px;
    place-items: center;
    color: #fff;
    border-radius: 50%;
    background: #16a34a;
  }

  .thanks-mark svg {
    width: 34px;
    height: 34px;
  }

  .thanks-card h1 {
    margin: 0 0 14px;
    color: #1d2733;
    font-size: 36px;
  }

  .thanks-card p {
    max-width: 540px;
    margin: 0 auto 28px;
    color: #5d6876;
    font-size: 17px;
    line-height: 1.7;
  }

  .thanks-card a {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    padding: 0 24px;
    color: #fff;
    font-weight: 700;
    border-radius: 8px;
    background: #c93715;
    text-decoration: none;
  }

  .thanks-card a:hover {
    color: #fff;
    background: #a82d11;
  }
</style>
