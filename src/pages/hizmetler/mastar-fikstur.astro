---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OptimizedImage from '../../components/OptimizedImage.astro';

const title = "Mastar ve Fikstür İmalatı | TARGET MAKİNA";
const description = "TARGET MAKİNA mastar ve fikstür imalatı hizmetleri. Kalite kontrol mastarı, bağlama fikstürü, kaynak fikstürü ve özel üretim aparatlarında hassas CNC çözümleri.";
const keywords = "mastar imalatı, fikstür imalatı, kalite kontrol mastarı, bağlama fikstürü, kaynak fikstürü, CNC aparat, Target Makina, İzmir CNC";
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <section class="detail-hero">
    <div class="hero-media">
      <OptimizedImage alt="Mastar ve Fikstür İmalatı" src="assets/images/anasayfa/mastar-fikstur.png" />
    </div>
    <div class="hero-shade"></div>
    <div class="container hero-content">
      <p class="breadcrumb"><a href="/">Ana Sayfa</a> / <a href="/hizmetler/">Hizmetler</a> / Mastar ve Fikstür İmalatı</p>
      <h1>Mastar ve Fikstür İmalatı</h1>
      <p>Üretim, ölçüm ve montaj süreçleriniz için tekrarlanabilirliği yüksek, sahada kullanıma hazır özel mastar ve fikstür çözümleri üretiyoruz.</p>
      <a class="primary-action quote-trigger" href="#teklif">Teklif Al</a>
    </div>
  </section>

  <section class="stats-band">
    <div class="container stats-grid">
      <div><strong>±0.005 mm</strong><span>kritik tolerans</span></div>
      <div><strong>CMM</strong><span>ölçüm doğrulama</span></div>
      <div><strong>CAD/CAM</strong><span>tasarım desteği</span></div>
      <div><strong>Tek parça</strong><span>ve seri üretim</span></div>
    </div>
  </section>

  <section class="content-section">
    <div class="container split">
      <div>
        <span class="eyebrow">Kapsam</span>
        <h2>Üretim hattına doğrudan uyumlu aparatlar</h2>
        <p>Kontrol mastarları, bağlama fikstürleri, kaynak fikstürleri ve montaj aparatlarını parçanın geometrisine, toleransına ve kullanım senaryosuna göre tasarlayıp işliyoruz.</p>
        <p>Her projede amaç yalnızca parçayı tutmak değil; operatör hatasını azaltmak, çevrim süresini kısaltmak ve ölçüm tekrarını güvenilir hale getirmektir.</p>
      </div>
      <div class="panel">
        <h3>Ürettiğimiz çözümler</h3>
        <ul>
          <li>Kalite kontrol mastarı ve go/no-go kontrol aparatları</li>
          <li>CNC bağlama fikstürü ve özel sıkma sistemleri</li>
          <li>Kaynak, montaj ve delme fikstürleri</li>
          <li>Seri üretim için operatör dostu üretim aparatları</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="process-section">
    <div class="container">
      <span class="eyebrow">Süreç</span>
      <h2>Kontrollü tasarım, hassas üretim</h2>
      <div class="process-grid">
        <div><span>01</span><h3>İhtiyaç analizi</h3><p>Parça çizimi, ölçüm noktaları, üretim adedi ve kullanım koşulları değerlendirilir.</p></div>
        <div><span>02</span><h3>Tasarım</h3><p>Bağlama, referanslama, erişim ve operatör ergonomisi dikkate alınarak fikstür tasarlanır.</p></div>
        <div><span>03</span><h3>İmalat</h3><p>CNC frezeleme, tornalama ve tel erozyon kabiliyetleriyle parçalar hassas şekilde üretilir.</p></div>
        <div><span>04</span><h3>Doğrulama</h3><p>CMM ve hassas ölçüm ekipmanlarıyla kritik ölçüler kontrol edilerek teslim edilir.</p></div>
      </div>
    </div>
  </section>

  <section class="content-section">
    <div class="container cta-box">
      <h2>Mastar veya fikstür projeniz mi var?</h2>
      <p>Teknik çiziminizi, numune parçanızı veya proses ihtiyacınızı paylaşın; uygulanabilir üretim çözümünü birlikte netleştirelim.</p>
      <a class="primary-action quote-trigger" href="#teklif">Hızlı Teklif Al</a>
    </div>
  </section>
</BaseLayout>

<style>
  .detail-hero{position:relative;min-height:460px;display:flex;align-items:center;overflow:hidden;background:linear-gradient(135deg,#7f1f0d 0%,#C93715 58%,#e04a28 100%)}
  .hero-media{position:absolute;inset:0}
  .hero-media img{width:100%;height:100%;object-fit:cover;opacity:.22;filter:saturate(.9) contrast(1.08);mix-blend-mode:multiply}
  .hero-media :global(img){width:100%;height:100%;object-fit:cover;opacity:.22;filter:saturate(.9) contrast(1.08);mix-blend-mode:multiply}
  .hero-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(92,18,7,.98),rgba(201,55,21,.9),rgba(201,55,21,.7))}
  .hero-content{position:relative;color:#fff;max-width:760px;text-shadow:0 2px 16px rgba(0,0,0,.22)}
  .breadcrumb{font-size:14px;color:rgba(255,255,255,.86);margin-bottom:18px}
  .breadcrumb a{color:#fff;text-decoration:none}
  .detail-hero h1{font-size:46px;line-height:1.15;margin:0 0 18px;font-weight:800;color:#fff}
  .detail-hero p:not(.breadcrumb){font-size:18px;line-height:1.7;margin:0 0 26px;max-width:680px;color:rgba(255,255,255,.94)}
  .primary-action{display:inline-flex;align-items:center;justify-content:center;background:#C93715;color:#fff;text-decoration:none;font-weight:700;border-radius:6px;padding:14px 28px;transition:background .2s,transform .2s}
  .primary-action:hover{background:#a82f13;color:#fff;transform:translateY(-1px)}
  .stats-band{background:#171717;color:#fff;padding:26px 0}
  .stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
  .stats-grid div{border-left:3px solid #C93715;padding-left:16px}
  .stats-grid strong{display:block;font-size:24px;margin-bottom:4px}
  .stats-grid span{font-size:14px;color:#bbb}
  .content-section{padding:76px 0;background:#fff}
  .split{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(280px,.85fr);gap:44px;align-items:start}
  .eyebrow{display:inline-block;color:#C93715;font-size:13px;font-weight:800;letter-spacing:1.2px;text-transform:uppercase;margin-bottom:12px}
  h2{font-size:32px;line-height:1.25;margin:0 0 18px;color:#1a1a1a}
  p{color:#555;line-height:1.75}
  .panel{background:#f7f7f7;border:1px solid #e8e8e8;border-radius:8px;padding:28px}
  .panel h3{margin:0 0 16px;color:#1a1a1a;font-size:22px}
  .panel ul{margin:0;padding-left:18px;color:#555;line-height:1.8}
  .process-section{padding:76px 0;background:#f7f7f7}
  .process-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-top:28px}
  .process-grid div{background:#fff;border:1px solid #e8e8e8;border-radius:8px;padding:24px;min-height:220px}
  .process-grid span{display:block;color:#C93715;font-weight:800;margin-bottom:18px}
  .process-grid h3{font-size:19px;margin:0 0 10px;color:#1a1a1a}
  .process-grid p{font-size:14px;margin:0}
  .cta-box{text-align:center;max-width:860px}
  .cta-box h2{margin-bottom:12px}
  .cta-box p{margin:0 auto 24px;max-width:680px}
  @media (max-width: 900px){
    .detail-hero{min-height:420px}
    .detail-hero h1{font-size:34px}
    .stats-grid,.process-grid,.split{grid-template-columns:1fr}
  }
</style>
