---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OptimizedImage from '../../components/OptimizedImage.astro';

const title = "Hizmetler | TARGET MAKİNA - CNC İşleme ve Hassas Üretim";
const description = "Target Makina; CNC frezeleme, CNC tornalama, 5 eksen CNC işleme, tel erozyon, mastar ve fikstür imalatı, hassas talaşlı imalat ve yüzey işlemleri sunar.";
const keywords = "CNC işleme hizmetleri, CNC frezeleme, CNC tornalama, 5 eksen CNC, tel erozyon, mastar fikstür imalatı, hassas talaşlı imalat, Target Makina";

const services = [
  {
    title: 'Tel Erozyon',
    href: '/makina-parkuru/sodick-vl400q/',
    image: 'assets/images/makina-parkuru/sodick-vl400q.png',
    summary: 'Sertleştirilmiş çelik, karbür ve özel alaşımlarda ince kesitli, yüksek hassasiyetli tel erozyon işlemleri.',
    points: ['Sodick tezgah altyapısı', 'İnce kanal ve profil kesimi', 'Mikron seviyesinde hassasiyet'],
  },
  {
    title: 'CNC 5 Eksen İşleme',
    href: '/hizmetler/5-eksen-cnc/',
    image: 'assets/images/5-eksen/hero.png',
    summary: 'Karmaşık geometrili parçaları tek bağlamada, yüksek doğruluk ve yüzey kalitesiyle işliyoruz.',
    points: ['Karmaşık yüzeyler', 'Tek bağlamada çok yönlü işleme', 'Havacılık ve savunma uyumu'],
  },
  {
    title: 'CNC Frezeleme',
    href: '/hizmetler/cnc-frezeleme/',
    image: 'assets/images/cnc-freze/hero.png',
    summary: 'Alüminyum, çelik, paslanmaz, pirinç ve plastik malzemelerde prototipten seri üretime CNC frezeleme.',
    points: ['3, 4 ve 5 eksen frezeleme', 'Dar toleranslı yüzeyler', 'Hızlı prototip üretimi'],
  },
  {
    title: 'CNC Tornalama',
    href: '/hizmetler/cnc-tornalama/',
    image: 'assets/images/cnc-torna/hero.png',
    summary: 'Mil, burç, flanş ve döner geometriye sahip teknik parçaları hassas toleranslarla üretiyoruz.',
    points: ['Silindirik parça üretimi', 'İç ve dış çap işleme', 'Tekil ve seri imalat'],
  },
  {
    title: 'Mastar ve Fikstür İmalatı',
    href: '/hizmetler/mastar-fikstur/',
    image: 'assets/images/anasayfa/mastar-fikstur.png',
    summary: 'Üretim ve kalite kontrol süreçleri için özel bağlama fikstürü, kontrol mastarı ve montaj aparatı üretimi.',
    points: ['Kontrol mastarları', 'Bağlama fikstürleri', 'Operatör dostu aparat tasarımı'],
  },
  {
    title: 'Hassas Talaşlı İmalat',
    href: '/hizmetler/hassas-talasli-imalat/',
    image: 'assets/images/anasayfa/hassas-talasli.png',
    summary: 'Teknik resme ve tolerans gereksinimlerine uygun hassas metal ve plastik parça üretimi.',
    points: ['Teknik resme uygun üretim', 'CMM ile kalite kontrol', 'Prototip ve seri üretim'],
  },
  {
    title: 'Parça Montajı',
    href: '/hizmetler/parca-montaji/',
    image: 'assets/images/montaj/hero_new.png',
    summary: 'İşlenmiş parçaların mekanik montajı, alt montaj grupları ve teslimata hazır üretim paketleri.',
    points: ['Alt montaj grupları', 'Fonksiyon kontrolü', 'Sevke hazır paketleme'],
  },
  {
    title: 'Yüzey İşleme',
    href: '/hizmetler/yuzey-isleme/',
    image: 'assets/images/yuzey/hero.png',
    summary: 'Eloksal, kumlama, polisaj, kaplama ve boya gibi yüzey işlemleriyle parçalarınızı kullanıma hazır hale getiriyoruz.',
    points: ['Eloksal ve kaplama', 'Kumlama ve polisaj', 'Korozyon dayanımı'],
  },
  {
    title: 'Sac Şekillendirme',
    href: '/hizmetler/sac-sekillendirme/',
    image: 'assets/images/sac/hero_new.png',
    summary: 'Büküm, kesim ve şekillendirme operasyonlarıyla endüstriyel sac parça ihtiyaçlarına çözüm sunuyoruz.',
    points: ['Hassas büküm', 'Kesim ve form verme', 'Proje bazlı üretim'],
  },
  {
    title: 'Dişli İmalatı',
    href: '/hizmetler/disli-imalati/',
    image: 'assets/images/disli/hero_new.png',
    summary: 'Makine ve aktarım sistemleri için özel dişli, mil ve hareket aktarım parçaları imalatı.',
    points: ['Özel dişli parçaları', 'Aktarım elemanları', 'Makine yedek parçaları'],
  },
];

const processSteps = [
  ['01', 'Teknik İnceleme', 'Çizim, numune veya 3D model üzerinden ölçü, malzeme ve tolerans gereksinimleri değerlendirilir.'],
  ['02', 'Üretim Planı', 'Uygun tezgah, bağlama yöntemi, takım yolu ve kalite kontrol adımları belirlenir.'],
  ['03', 'Hassas İmalat', 'CNC işleme, tel erozyon, fikstür veya yüzey işlem operasyonları kontrollü şekilde yürütülür.'],
  ['04', 'Kontrol ve Teslim', 'Kritik ölçüler kontrol edilir, parçalar korunarak paketlenir ve teslimata hazırlanır.'],
];
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <section class="services-hero">
    <div class="hero-image">
      <OptimizedImage alt="TARGET MAKİNA CNC işleme hizmetleri" src="assets/images/anasayfa/cnc-tanitim.png" loading="eager" />
    </div>
    <div class="hero-overlay"></div>
    <div class="container hero-content">
      <p class="breadcrumb"><a href="/">Ana Sayfa</a> / Hizmetler</p>
      <h1>CNC İşleme ve Hassas Üretim Hizmetleri</h1>
      <p>İzmir merkezli üretim altyapımızla prototip, özel parça, mastar, fikstür ve seri imalat ihtiyaçlarınız için uçtan uca teknik çözüm sunuyoruz.</p>
      <div class="hero-actions">
        <a class="primary-action quote-trigger" href="#teklif">Teklif Al</a>
        <a class="secondary-action" href="/makina-parkuru/">Makina Parkurunu Gör</a>
      </div>
    </div>
  </section>

  <section class="metric-band">
    <div class="container metric-grid">
      <div><strong>±0.005 mm</strong><span>kritik tolerans hedefi</span></div>
      <div><strong>5 eksen</strong><span>karmaşık geometri işleme</span></div>
      <div><strong>CMM</strong><span>ölçüm ve kalite kontrol</span></div>
      <div><strong>1+ adet</strong><span>prototipten seri üretime</span></div>
    </div>
  </section>

  <section class="services-section">
    <div class="container">
      <div class="section-head">
        <span>Hizmetlerimiz</span>
        <h2>İhtiyacınıza göre doğru üretim yöntemi</h2>
        <p>Her hizmet sayfası ilgili üretim kabiliyetini, kullanım alanını ve teknik avantajları ayrıntılı anlatır.</p>
      </div>
      <div class="service-grid">
        {services.map((service) => (
          <article class="service-card">
            <a class="image-link" href={service.href} aria-label={service.title}>
              <OptimizedImage alt={service.title} src={service.image} />
            </a>
            <div class="card-body">
              <h3><a href={service.href}>{service.title}</a></h3>
              <p>{service.summary}</p>
              <ul>
                {service.points.map((point) => <li>{point}</li>)}
              </ul>
              <a class="more-link" href={service.href}>Detayları İncele</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="process-section">
    <div class="container">
      <div class="section-head compact">
        <span>Çalışma Süreci</span>
        <h2>Tekliften teslimata kontrollü üretim</h2>
      </div>
      <div class="process-grid">
        {processSteps.map(([no, title, text]) => (
          <div class="process-card">
            <strong>{no}</strong>
            <h3>{title}</h3>
            <p>{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="quality-section">
    <div class="container quality-wrap">
      <div class="quality-copy">
        <span>Kalite Yaklaşımı</span>
        <h2>Parçanın ölçüsü kadar kullanım amacı da önemlidir</h2>
        <p>Üretim öncesinde parça geometrisi, malzeme, yüzey işlemi, montaj uyumu ve kritik ölçüler birlikte değerlendirilir. Gerektiğinde üretilebilirlik analiziyle tasarım iyileştirme önerileri sunulur.</p>
        <p>Bu yaklaşım, tekrar eden üretimlerde fireyi azaltır, teslimat sürecini hızlandırır ve parçanın sahadaki performansını güvence altına alır.</p>
      </div>
      <div class="quality-image">
        <OptimizedImage alt="TARGET MAKİNA kalite kontrol ve hassas üretim" src="assets/images/anasayfa/kalite.png" />
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container">
      <h2>Üretilecek parçanız veya teknik çiziminiz hazır mı?</h2>
      <p>Dosyanızı paylaşın; malzeme, tolerans, yüzey işlemi ve teslim süresine göre hızlıca teklif hazırlayalım.</p>
      <a class="primary-action quote-trigger" href="#teklif">Hızlı Teklif Al</a>
    </div>
  </section>
</BaseLayout>

<style>
  .services-hero{position:relative;min-height:520px;display:flex;align-items:center;overflow:hidden;background:linear-gradient(135deg,#7f1f0d 0%,#C93715 58%,#e04a28 100%)}
  .hero-image{position:absolute;inset:0}
  .hero-image img{width:100%;height:100%;object-fit:cover;opacity:.2;filter:saturate(.9) contrast(1.08);mix-blend-mode:multiply}
  .hero-image :global(img){width:100%;height:100%;object-fit:cover;opacity:.2;filter:saturate(.9) contrast(1.08);mix-blend-mode:multiply}
  .hero-overlay{position:absolute;inset:0;background:linear-gradient(90deg,rgba(92,18,7,.98),rgba(201,55,21,.9),rgba(201,55,21,.7))}
  .hero-content{position:relative;color:#fff;max-width:800px;text-shadow:0 2px 16px rgba(0,0,0,.22)}
  .breadcrumb{font-size:14px;margin-bottom:18px;color:rgba(255,255,255,.86)}
  .breadcrumb a{color:#fff;text-decoration:none}
  .services-hero h1{font-size:48px;line-height:1.12;margin:0 0 18px;font-weight:800;letter-spacing:0;color:#fff}
  .services-hero p:not(.breadcrumb){font-size:18px;line-height:1.7;max-width:720px;margin:0 0 28px;color:rgba(255,255,255,.94)}
  .hero-actions{display:flex;gap:14px;flex-wrap:wrap}
  .primary-action,.secondary-action{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 24px;border-radius:6px;font-weight:700;text-decoration:none;transition:background .2s,transform .2s,border-color .2s}
  .primary-action{background:#C93715;color:#fff}
  .primary-action:hover{background:#a92f13;color:#fff;transform:translateY(-1px)}
  .secondary-action{border:1px solid rgba(255,255,255,.55);color:#fff;background:rgba(255,255,255,.08)}
  .secondary-action:hover{border-color:#fff;background:rgba(255,255,255,.15);color:#fff}
  .metric-band{background:#171717;color:#fff;padding:28px 0}
  .metric-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
  .metric-grid div{border-left:3px solid #C93715;padding-left:16px}
  .metric-grid strong{display:block;font-size:24px;margin-bottom:4px}
  .metric-grid span{display:block;color:#bbb;font-size:14px}
  .services-section,.quality-section{padding:78px 0;background:#fff}
  .section-head{text-align:center;max-width:760px;margin:0 auto 42px}
  .section-head.compact{margin-bottom:30px}
  .section-head span,.quality-copy span{display:inline-block;color:#C93715;font-size:13px;font-weight:800;letter-spacing:1.2px;text-transform:uppercase;margin-bottom:12px}
  .section-head h2,.quality-copy h2,.cta-section h2{font-size:34px;line-height:1.25;color:#1a1a1a;margin:0 0 14px;font-weight:800}
  .section-head p,.quality-copy p,.cta-section p{color:#555;line-height:1.75;margin:0}
  .service-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
  .service-card{background:#fff;border:1px solid #e8e8e8;border-radius:8px;overflow:hidden;box-shadow:0 8px 26px rgba(0,0,0,.05);display:flex;flex-direction:column;min-height:100%}
  .image-link{display:block;aspect-ratio:16/10;background:#f2f2f2;overflow:hidden}
  .image-link img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .25s}
  .service-card:hover .image-link img{transform:scale(1.04)}
  .card-body{padding:24px;display:flex;flex-direction:column;flex:1}
  .card-body h3{font-size:21px;margin:0 0 10px;color:#1a1a1a}
  .card-body h3 a{color:inherit;text-decoration:none}
  .card-body p{font-size:15px;line-height:1.7;color:#555;margin:0 0 16px}
  .card-body ul{margin:0 0 20px;padding-left:18px;color:#555;line-height:1.65;font-size:14px}
  .more-link{margin-top:auto;color:#C93715;font-weight:800;text-decoration:none}
  .more-link:hover{text-decoration:underline}
  .process-section{padding:74px 0;background:#f7f7f7}
  .process-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
  .process-card{background:#fff;border:1px solid #e7e7e7;border-radius:8px;padding:24px;min-height:220px}
  .process-card strong{display:block;color:#C93715;font-size:24px;margin-bottom:18px}
  .process-card h3{font-size:19px;color:#1a1a1a;margin:0 0 10px}
  .process-card p{font-size:14px;color:#555;line-height:1.7;margin:0}
  .quality-wrap{display:grid;grid-template-columns:minmax(0,1fr) minmax(320px,.9fr);gap:44px;align-items:center}
  .quality-copy p + p{margin-top:14px}
  .quality-image{border-radius:8px;overflow:hidden;box-shadow:0 16px 40px rgba(0,0,0,.12)}
  .quality-image img{width:100%;height:420px;object-fit:cover;display:block}
  .cta-section{background:#171717;color:#fff;text-align:center;padding:72px 0}
  .cta-section h2{color:#fff}
  .cta-section p{color:#ccc;max-width:680px;margin:0 auto 24px}
  @media (max-width: 980px){
    .services-hero h1{font-size:36px}
    .metric-grid,.service-grid,.process-grid,.quality-wrap{grid-template-columns:1fr 1fr}
  }
  @media (max-width: 640px){
    .services-hero{min-height:500px}
    .services-hero h1{font-size:30px}
    .metric-grid,.service-grid,.process-grid,.quality-wrap{grid-template-columns:1fr}
    .quality-image img{height:300px}
  }
</style>
