---
import BaseLayout from '../layouts/BaseLayout.astro';
import OptimizedImage from '../components/OptimizedImage.astro';

const title = "Endüstriyel Vaka Çalışmaları & Projeler | TARGET MAKİNA";
const description = "Target Makina - Otomotiv, spor, tüketici ürünleri ve makine sanayisi için ürettiğimiz özel CNC parçalarına ait vaka çalışmaları.";
const keywords = "CNC Projeleri, Özel CNC Parçaları, Otomotiv Vaka Çalışmaları, Makine Parçaları İmalatı, İzmir CNC, Telerezyon, İzmir Telerezyon, CNC 5 Eksen, Mastar İmalatı, Fikstür İmalatı, Talaşlı İmalat, Hassas Talaşlı imalat";
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <section class="page-hero">
<div class="container">
<div class="row">
<div class="col-lg-8">
<p style="font-size: 0.9rem; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 10px;">Ana Sayfa • Kaynaklar • Vaka Çalışmaları</p>
<h1>Sektörel <span>Vaka Çalışmaları</span></h1>
<p>Otomotiv, spor, tüketici ürünleri ve makine sanayisi için ürettiğimiz özel CNC parçalarına ait vaka çalışmaları ve projelerimizin detaylı teknik analizleri.</p>
<a class="btn btn-primary mt-4 quote-trigger" href="#teklif" style="background-color: #d43315; border-color: #d43315; padding: 12px 30px; font-weight: bold; border-radius: 30px;">Teklif Al →</a>
</div>
</div>
</div>
</section>
<section class="stats-bar">
<div class="container">
<div class="row">
<div class="col-md-3 col-6 stat-box">
<h4>Endüstri</h4>
<p>Farklı Sektör Çözümleri</p>
</div>
<div class="col-md-3 col-6 stat-box">
<h4>Hassasiyet</h4>
<p>±0.01 mm Doğruluk</p>
</div>
<div class="col-md-3 col-6 stat-box mt-4 mt-md-0">
<h4>Kalite Raporu</h4>
<p>%100 Ölçüsel Denetim</p>
</div>
<div class="col-md-3 col-6 stat-box mt-4 mt-md-0">
<h4>Teknik Destek</h4>
<p>DFM Mühendislik Hizmeti</p>
</div>
</div>
</div>
</section>
<section class="portal-grid">
<div class="container">
<div class="section-title">
<h2>Sektörlere Göre Vaka Çalışmaları</h2>
<p style="color: #666; max-width: 600px; margin: 15px auto 0;">Farklı kullanım alanları için ürettiğimiz yüksek standartlı özel parçaları inceleyin:</p>
</div>
<div class="row">
<!-- 1. MAKİNE VE İLETİM PARÇALARI -->
<div class="col-lg-6 col-md-6">
<div class="portal-card">
<div class="portal-img-box">
<a href="/sektorler/makina-transmisyon/">
<OptimizedImage alt="Makine ve İletim Parçaları" src="assets/images/makine/gears_racks.jpg"/>
</a>
</div>
<div class="portal-info">
<h3>Makine ve Güç Aktarım Parçaları</h3>
<p>Gıda, havacılık, savunma sanayisi ve otomasyon makineleri için ürettiğimiz dişliler, kremayerler, sinyal alıcı muhafazaları ve özel mil şaftları.</p>
<a class="portal-btn" href="/sektorler/makina-transmisyon/">Projeleri İncele <i class="fas fa-arrow-right"></i></a>
</div>
</div>
</div>
<!-- 2. OTOMOTİV PARÇALARI -->
<div class="col-lg-6 col-md-6">
<div class="portal-card">
<div class="portal-img-box">
<a href="/sektorler/otomotiv/">
<OptimizedImage alt="Otomotiv Parçaları" src="assets/images/otomotiv/jant_kapagi.png"/>
</a>
</div>
<div class="portal-info">
<h3>Otomotiv Parçaları</h3>
<p>Özel araç jant kapakları, vites kolları, far gövdeleri, yakıt deposu kapakları ve dikiz aynası bağlantı bileşenleri gibi yüksek hassasiyetli parçalar.</p>
<a class="portal-btn" href="/sektorler/otomotiv/">Projeleri İncele <i class="fas fa-arrow-right"></i></a>
</div>
</div>
</div>
<!-- 3. SPOR VE YARIŞ EKİPMANLARI -->
<div class="col-lg-6 col-md-6">
<div class="portal-card">
<div class="portal-img-box">
<a href="/sektorler/spor/">
<OptimizedImage alt="Spor ve Yarış Ekipmanları" src="assets/images/spor/wheels.jpg"/>
</a>
</div>
<div class="portal-info">
<h3>Spor ve Yarış Ekipmanları</h3>
<p>Yarış arabası direksiyon kontrol mekanizmaları, skateboard tekerlekleri, egzoz ve susturucu boruları gibi ekstrem spor yarış parçaları.</p>
<a class="portal-btn" href="/sektorler/spor/">Projeleri İncele <i class="fas fa-arrow-right"></i></a>
</div>
</div>
</div>
<!-- 4. TÜKETİCİ ÜRÜNLERİ & GÜNLÜK TÜKETİM -->
<div class="col-lg-6 col-md-6">
<div class="portal-card">
<div class="portal-img-box">
<a href="/sektorler/tuketim/">
<OptimizedImage alt="Günlük Tüketim Ürünleri" src="assets/images/gunluk/camera.jpg"/>
</a>
</div>
<div class="portal-info">
<h3>Tüketici Ürünleri &amp; Günlük Tüketim</h3>
<p>Kişisel bakım ürünleri (tıraş sapları, dövme makineleri), kamera gövdeleri, cüzdan çerçeveleri ve aydınlatma bağlantı bileşenleri.</p>
<a class="portal-btn" href="/sektorler/tuketim/">Projeleri İncele <i class="fas fa-arrow-right"></i></a>
</div>
</div>
</div>
</div>
</div>
</section>
<section class="cta-section">
<div class="container">
<h3>Kendi Özel Projenizi Başlatın</h3>
<p style="max-width: 700px; margin: 0 auto 30px; font-size: 1.1rem; opacity: 0.9;">Hangi sektörde olursanız olun, özel tasarımlarınızı üretecek ve yüksek kaliteyle teslim edecek üretim kapasitesine sahibiz.</p>
<a class="btn-light-custom" href="/iletisim/">Bizimle İletişime Geçin →</a>
</div>
</section>
</BaseLayout>

<style>
  .page-hero {
            background: linear-gradient(135deg, rgba(30,30,30,0.95) 0%, rgba(10,10,10,0.85) 100%);
            padding: 100px 0;
            color: white;
            border-bottom: 5px solid #d43315;
        }
        .page-hero h1 { font-weight: 800; font-size: 3rem; text-transform: uppercase; }
        .page-hero h1 span { color: #d43315; }
        .page-hero p { font-size: 1.1rem; max-width: 650px; margin-top: 15px; opacity: 0.9; }

        .stats-bar { background-color: #1a1a1a; padding: 40px 0; color: white; }
        .stat-box { text-align: center; border-right: 1px solid #333; }
        .stat-box:last-child { border: none; }
        .stat-box h4 { color: #d43315; font-size: 1.8rem; font-weight: bold; margin-bottom: 5px; }
        .stat-box p { margin: 0; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px; color: #aaa; }

        .portal-grid {
            padding: 80px 0;
            background-color: #f9f9f9;
        }
        .section-title {
            text-align: center;
            margin-bottom: 60px;
        }
        .section-title h2 {
            font-size: 2.5rem;
            font-weight: 800;
            color: #1a1a1a;
            text-transform: uppercase;
            position: relative;
            display: inline-block;
            padding-bottom: 15px;
        }
        .section-title h2::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 80px;
            height: 4px;
            background-color: #d43315;
        }

        .portal-card {
            background: #fff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            margin-bottom: 40px;
            transition: all 0.3s ease;
            height: calc(100% - 40px);
            display: flex;
            flex-direction: column;
            border: 1px solid #eee;
        }
        .portal-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.12);
            border-color: #d43315;
        }
        .portal-img-box {
            width: 100%;
            height: 220px;
            overflow: hidden;
            position: relative;
            background-color: #eaeaea;
        }
        .portal-img-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }
        .portal-card:hover .portal-img-box img {
            transform: scale(1.08);
        }
        .portal-info {
            padding: 25px;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }
        .portal-info h3 {
            font-size: 1.4rem;
            font-weight: 700;
            color: #1a1a1a;
            margin-bottom: 15px;
        }
        .portal-info p {
            font-size: 0.95rem;
            color: #666;
            line-height: 1.6;
            margin-bottom: 25px;
            flex-grow: 1;
        }
        .portal-btn {
            align-self: flex-start;
            color: #d43315;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 1px;
            text-decoration: none;
            transition: 0.3s;
            display: flex;
            align-items: center;
        }
        .portal-btn i {
            margin-left: 8px;
            transition: transform 0.3s;
        }
        .portal-card:hover .portal-btn {
            color: #1a1a1a;
        }
        .portal-card:hover .portal-btn i {
            transform: translateX(5px);
        }

        .cta-section { background-color: #d43315; color: white; padding: 60px 0; text-align: center; }
        .cta-section h3 { font-weight: 700; margin-bottom: 20px; }
        .btn-light-custom { background-color: white; color: #d43315; font-weight: bold; padding: 12px 30px; border-radius: 30px; text-decoration: none; display: inline-block; transition: 0.3s; }
        .btn-light-custom:hover { background-color: #1a1a1a; color: white; }
</style>
