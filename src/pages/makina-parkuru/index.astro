---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OptimizedImage from '../../components/OptimizedImage.astro';

const title = "Makina Parkuru | TARGET MAKİNA";
const description = "TARGET MAKİNA makina parkuru - Sodick tel erozyon, DMG MORI CNC işleme merkezi ve Hexagon CMM koordinat ölçüm cihazı ile hassas üretim hizmetleri.";
const keywords = "CNC işleme, CNC frezeleme, CNC tornalama, hassas üretim, endüstriyel makina, Target Makina, İzmir CNC, makina parkuru, Makina Parkuru, Telerezyon, İzmir Telerezyon, CNC 5 Eksen, Mastar İmalatı, Fikstür İmalatı, Talaşlı İmalat, Hassas Talaşlı imalat";
---

<BaseLayout title={title} description={description} keywords={keywords}>
<div class="machine-hero">
<div class="container">
<p class="hero-kicker">Üretim Altyapısı</p>
<h1>Makina Parkuru</h1>
<p class="hero-lead">Tel erozyon, CNC işleme merkezleri ve CMM ölçüm altyapısıyla hassas üretim projelerini kontrollü şekilde yürütüyoruz.</p>
<p class="breadcrumb-text"><a href="/">Ana Sayfa</a> » Makina Parkuru</p>
</div>
</div>
<div style="padding: 50px 0 10px; text-align: center;">
<div class="container">
<p style="font-size: 18px; color: #555; max-width: 800px; margin: 0 auto; line-height: 1.8;">
                TARGET MAKİNA olarak, yüksek hassasiyetli üretim standartlarımızı sürdürmek için sektörün önde gelen markalarına ait CNC tezgahlar ve ölçüm cihazları kullanmaktayız. Makinalarımız düzenli olarak bakım ve kalibrasyondan geçirilmektedir.
            </p>
</div>
</div>
<!-- Machine Grid -->
<div class="other-machines" style="padding-top: 30px;">
<div class="container">
<div class="row">
<div class="col-lg-4 col-md-6">
<div class="machine-card">
<OptimizedImage alt="Sodick VL400Q Tel Erozyon" src="assets/images/makina-parkuru/sodick-vl400q.png"/>
<div class="card-body">
<h3><a href="/makina-parkuru/sodick-vl400q/">Sodick VL400Q Tel Erozyon</a></h3>
<span class="cat">Tel Erozyon (Wire EDM)</span>
<p style="margin-top:10px; font-size:14px; color:#777; line-height:1.5;">Sodick VL400Q, lineer motor tahrikli yüksek hassasiyetli tel erozyon tezgahıdır. 10 yıl konumlama doğruluğu garantisi il...</p>
<a href="/makina-parkuru/sodick-vl400q/" style="display:inline-block; margin-top:12px; color:#C93715; font-weight:600; text-decoration:none;">Detayları Gör →</a>
</div>
</div>
</div>
<div class="col-lg-4 col-md-6">
<div class="machine-card">
<OptimizedImage alt="Sodick AQ537L Tel Erozyon" src="assets/images/makina-parkuru/sodick-aq537l.png"/>
<div class="card-body">
<h3><a href="/makina-parkuru/sodick-aq537l/">Sodick AQ537L Tel Erozyon</a></h3>
<span class="cat">Tel Erozyon (Wire EDM)</span>
<p style="margin-top:10px; font-size:14px; color:#777; line-height:1.5;">Sodick AQ537L, geniş çalışma alanı ve lineer tahrik teknolojisi ile donatılmış hassas CNC tel erozyon tezgahıdır. Büyük ...</p>
<a href="/makina-parkuru/sodick-aq537l/" style="display:inline-block; margin-top:12px; color:#C93715; font-weight:600; text-decoration:none;">Detayları Gör →</a>
</div>
</div>
</div>
<div class="col-lg-4 col-md-6">
<div class="machine-card">
<OptimizedImage alt="DMG MORI ecoMill 600V" src="assets/images/makina-parkuru/dmg-ecomill-600v.png"/>
<div class="card-body">
<h3><a href="/makina-parkuru/dmg-ecomill-600v/">DMG MORI ecoMill 600V</a></h3>
<span class="cat">CNC Dikey İşleme Merkezi</span>
<p style="margin-top:10px; font-size:14px; color:#777; line-height:1.5;">DMG MORI ecoMill 600V, 3 eksenli dikey işleme merkezidir. 12.000 RPM mil devri, 30 takımlık magazin ve 600 kg iş parçası...</p>
<a href="/makina-parkuru/dmg-ecomill-600v/" style="display:inline-block; margin-top:12px; color:#C93715; font-weight:600; text-decoration:none;">Detayları Gör →</a>
</div>
</div>
</div>
<div class="col-lg-4 col-md-6">
<div class="machine-card">
<OptimizedImage alt="DMG MORI ecoMill 70" src="assets/images/makina-parkuru/dmg-ecomill-70.png"/>
<div class="card-body">
<h3><a href="/makina-parkuru/dmg-ecomill-70/">DMG MORI ecoMill 70</a></h3>
<span class="cat">5 Eksen CNC İşleme Merkezi</span>
<p style="margin-top:10px; font-size:14px; color:#777; line-height:1.5;">DMG MORI ecoMill 70, 5 eksenli dikey işleme merkezidir. B ve C döner eksenleri sayesinde karmaşık geometrilerin tek bağl...</p>
<a href="/makina-parkuru/dmg-ecomill-70/" style="display:inline-block; margin-top:12px; color:#C93715; font-weight:600; text-decoration:none;">Detayları Gör →</a>
</div>
</div>
</div>
<div class="col-lg-4 col-md-6">
<div class="machine-card">
<OptimizedImage alt="Hexagon CMM 500x800" src="assets/images/makina-parkuru/hexagon-cmm.png"/>
<div class="card-body">
<h3><a href="/makina-parkuru/hexagon-cmm/">Hexagon CMM 500x800</a></h3>
<span class="cat">Koordinat Ölçüm Cihazı (CMM)</span>
<p style="margin-top:10px; font-size:14px; color:#777; line-height:1.5;">Hexagon GLOBAL S serisi koordinat ölçüm cihazı, 500x800 mm ölçüm hacmi ile üretim kalite kontrolünde en yüksek hassasiye...</p>
<a href="/makina-parkuru/hexagon-cmm/" style="display:inline-block; margin-top:12px; color:#C93715; font-weight:600; text-decoration:none;">Detayları Gör →</a>
</div>
</div>
</div>
</div>
</div>
</div>
<div class="cta-section">
<div class="container">
<h2>Üretim Kapasitemiz Hakkında Bilgi Alın</h2>
<p>Projeleriniz için en uygun çözümü sunmak üzere hazırız.</p>
<a class="cta-btn" href="/iletisim/">Bize Ulaşın</a>
</div>
</div>
</BaseLayout>

<style>
  .machine-hero { position:relative;overflow:hidden;background:linear-gradient(135deg,#7f1f0d 0%,#C93715 58%,#e04a28 100%);padding:86px 0 70px;color:#fff; }
        .machine-hero::after { content:'';position:absolute;right:-110px;top:-160px;width:420px;height:420px;border-radius:50%;background:rgba(255,255,255,.1); }
        .machine-hero .container { position:relative;z-index:1;max-width:840px; }
        .machine-hero .hero-kicker { margin:0 0 12px;color:rgba(255,255,255,.82);font-size:13px;font-weight:800;letter-spacing:1.2px;text-transform:uppercase; }
        .machine-hero h1 { color:#fff;font-size:46px;line-height:1.15;font-weight:800;margin:0 0 16px;font-family:var(--title-font-family);text-shadow:0 2px 16px rgba(0,0,0,.22); }
        .machine-hero .hero-lead { max-width:720px;margin:0 0 18px;color:rgba(255,255,255,.94);font-size:18px;line-height:1.7;text-shadow:0 2px 16px rgba(0,0,0,.18); }
        .machine-hero .breadcrumb-text { color:rgba(255,255,255,.84); font-size:15px; margin:0; }
        .machine-hero .breadcrumb-text a { color:#fff; text-decoration:none; }
        .machine-hero .breadcrumb-text a:hover { color:rgba(255,255,255,.86); }
        .machine-detail { padding: 60px 0; }
        .machine-image { border-radius: 12px; overflow: hidden; box-shadow: 0 8px 30px rgba(0,0,0,0.12); margin-bottom: 30px; }
        .machine-image img { width: 100%; height: auto; display: block; }
        .machine-category { display: inline-block; background: rgba(201,55,21,0.1); color: #C93715; padding: 6px 16px; border-radius: 20px; font-size: 14px; font-weight: 600; margin-bottom: 15px; }
        .machine-desc { font-size: 16px; line-height: 1.8; color: #555; margin-bottom: 30px; }
        .specs-table { width: 100%; border-collapse: collapse; margin-bottom: 30px; }
        .specs-table th { background: #C93715; color: #fff; padding: 14px 20px; text-align: left; font-size: 18px; font-weight: 600; }
        .specs-table td { padding: 12px 20px; border-bottom: 1px solid #eee; font-size: 15px; }
        .specs-table tr:nth-child(even) td { background: #f9f9f9; }
        .specs-table td:first-child { font-weight: 600; color: #333; width: 40%; }
        .specs-table td:last-child { color: #555; }
        .features-section { background: #f8f8f8; padding: 40px 0; }
        .features-section h2 { font-size: 28px; font-weight: 700; color: #222; margin-bottom: 30px; font-family: var(--title-font-family); }
        .feature-item { display: flex; align-items: flex-start; margin-bottom: 15px; }
        .feature-item .check { color: #C93715; font-size: 20px; margin-right: 12px; flex-shrink: 0; margin-top: 2px; }
        .feature-item p { margin: 0; font-size: 15px; line-height: 1.6; color: #555; }
        .cta-section { background: linear-gradient(135deg, #C93715 0%, #e04a28 100%); padding: 50px 0; text-align: center; color: #fff; }
        .cta-section h2 { font-size: 28px; font-weight: 700; margin-bottom: 15px; }
        .cta-section p { font-size: 16px; margin-bottom: 25px; opacity: 0.9; }
        .cta-btn { display: inline-block; background: #fff; color: #C93715; padding: 14px 40px; border-radius: 30px; font-size: 16px; font-weight: 600; text-decoration: none; transition: all 0.3s; }
        .cta-btn:hover { background: #222; color: #fff; }
        .other-machines { padding: 60px 0; }
        .other-machines h2 { font-size: 28px; font-weight: 700; text-align: center; margin-bottom: 40px; font-family: var(--title-font-family); }
        .machine-card { background: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.08); transition: transform 0.3s, box-shadow 0.3s; margin-bottom: 30px; }
        .machine-card:hover { transform: translateY(-5px); box-shadow: 0 8px 30px rgba(0,0,0,0.15); }
        .machine-card img { width: 100%; height: 200px; object-fit: cover; }
        .machine-card .card-body { padding: 20px; }
        .machine-card h3 { font-size: 18px; font-weight: 700; margin-bottom: 8px; }
        .machine-card h3 a { color: #222; text-decoration: none; }
        .machine-card h3 a:hover { color: #C93715; }
        .machine-card .cat { font-size: 13px; color: #999; }
</style>
