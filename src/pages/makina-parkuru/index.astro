</BaseLayout>

<style>
  .machine-hero { background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%); padding: 60px 0 40px; color: #fff; }
        .machine-hero h1 { font-size: 36px; font-weight: 700; margin-bottom: 10px; font-family: var(--title-font-family); }
        .machine-hero .breadcrumb-text { color: rgba(255,255,255,0.7); font-size: 15px; }
        .machine-hero .breadcrumb-text a { color: rgba(201,55,21,0.9); text-decoration: none; }
        .machine-hero .breadcrumb-text a:hover { color: #C93715; }
        .machine-detail { padding: 60px 0; }
        .machine-image { border-radius: 12px; overflow: hidden; box-shadow: 0 8px 30px rgba(0,0,0,0.12); margin-bottom: 30px; }
        .machine-image img { width: 100%; height: auto; display: block; }
        .machine-category { display: inline-block; background: rgba(201,55,21,0.1); color: #C93715; padding: 6px 16px; border-radius: 20px; font-size: 14px; font-weight: 600; margin-bottom: 15px; }
        .machine-desc { font-size: 16px; line-height: 1.8; color: #555; margin-bottom: 30px; }
        .specs-table { width: 100%; border-collapse: collapse; margin-bottom: 30px; }
        .specs-table th { background: #C93715; color: #fff; padding: 14px 20px; text-align: left; font-size: 18px; font-weight: 600; }
        .specs-table td { padding: 12px 20px; border-bottom: 1px solid #eee; font-size: 15px; }
        .specs-table tr:nth-child(even) td { background: #f9f9f9; }
        .specs-table td:first-child { font-weight: 600; color: #333; width: 40%; }
        .specs-table td:last-child { color: #555; }
        .features-section { background: #f8f8f8; padding: 40px 0; }
        .features-section h2 { font-size: 28px; font-weight: 700; color: #222; margin-bottom: 30px; font-family: var(--title-font-family); }
        .feature-item { display: flex; align-items: flex-start; margin-bottom: 15px; }
        .feature-item .check { color: #C93715; font-size: 20px; margin-right: 12px; flex-shrink: 0; margin-top: 2px; }
        .feature-item p { margin: 0; font-size: 15px; line-height: 1.6; color: #555; }
        .cta-section { background: linear-gradient(135deg, #C93715 0%, #e04a28 100%); padding: 50px 0; text-align: center; color: #fff; }
        .cta-section h2 { font-size: 28px; font-weight: 700; margin-bottom: 15px; }
        .cta-section p { font-size: 16px; margin-bottom: 25px; opacity: 0.9; }
        .cta-btn { display: inline-block; background: #fff; color: #C93715; padding: 14px 40px; border-radius: 30px; font-size: 16px; font-weight: 600; text-decoration: none; transition: all 0.3s; }
        .cta-btn:hover { background: #222; color: #fff; }
        .other-machines { padding: 60px 0; }
        .other-machines h2 { font-size: 28px; font-weight: 700; text-align: center; margin-bottom: 40px; font-family: var(--title-font-family); }
        .machine-card { background: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.08); transition: transform 0.3s, box-shadow 0.3s; margin-bottom: 30px; }
        .machine-card:hover { transform: translateY(-5px); box-shadow: 0 8px 30px rgba(0,0,0,0.15); }
        .machine-card img { width: 100%; height: 200px; object-fit: cover; }
        .machine-card .card-body { padding: 20px; }
        .machine-card h3 { font-size: 18px; font-weight: 700; margin-bottom: 8px; }
        .machine-card h3 a { color: #222; text-decoration: none; }
        .machine-card h3 a:hover { color: #C93715; }
        .machine-card .cat { font-size: 13px; color: #999; }
</style>