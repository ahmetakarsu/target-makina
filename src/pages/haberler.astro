---
import BaseLayout from '../layouts/BaseLayout.astro';
import OptimizedImage from '../components/OptimizedImage.astro';

const title = "Haberler | TARGET MAKİNA - CNC İşleme ve Üretim Gündemi";
const description = "TARGET MAKİNA haberler sayfası. CNC işleme, 5 eksen CNC, yüzey işlemleri, otomotiv parçaları ve hassas üretim alanındaki güncel yazılar.";
const keywords = "Target Makina haberler, CNC işleme haberleri, 5 eksen CNC, hassas talaşlı imalat, otomotiv parçaları, yüzey işlemleri";

const featured = {
  title: 'Hassas üretimde doğru proses seçimi neden önemlidir?',
  href: '/hizmetler/hassas-talasli-imalat/',
  image: 'assets/images/anasayfa/hassas-talasli.png',
  date: '05.12.2025',
  category: 'Üretim Rehberi',
  summary: 'Malzeme, tolerans, yüzey kalitesi ve teslim süresi birlikte değerlendirildiğinde CNC işleme projelerinde daha doğru maliyet ve daha güvenilir parça performansı elde edilir.',
};

const news = [
  {
    title: 'Otomotiv parçalarında özel CNC işleme çözümleri',
    href: '/sektorler/otomotiv/',
    image: 'assets/images/haberler/news_otomotiv.png',
    date: '03.12.2025',
    category: 'Sektörler',
    summary: 'Prototip geliştirme, modifikasyon parçaları ve düşük adetli özel üretimler için otomotiv sektöründe CNC işlemenin sunduğu avantajlar.',
  },
  {
    title: '5 eksen CNC işleme ile karmaşık geometriler',
    href: '/hizmetler/5-eksen-cnc/',
    image: 'assets/images/haberler/news_5eksen.png',
    date: '02.12.2025',
    category: 'CNC Teknolojisi',
    summary: 'Tek bağlamada çok yüzeyli işleme, daha az kurulum hatası ve yüksek hassasiyet gerektiren parçalar için 5 eksen CNC yaklaşımı.',
  },
  {
    title: 'Eloksal kaplama alüminyum parçalara ne kazandırır?',
    href: '/hizmetler/yuzey-isleme/',
    image: 'assets/images/haberler/news_eloksal.png',
    date: '01.12.2025',
    category: 'Yüzey İşlemleri',
    summary: 'Alüminyum parçalar için korozyon dayanımı, yüzey sertliği ve görsel kalite sağlayan eloksal kaplama sürecine kısa bir bakış.',
  },
  {
    title: 'Mastar ve fikstür imalatında tekrarlanabilirlik',
    href: '/hizmetler/mastar-fikstur/',
    image: 'assets/images/anasayfa/mastar-fikstur.png',
    date: '29.11.2025',
    category: 'Kalite Kontrol',
    summary: 'Kontrol mastarı ve bağlama fikstürleri, üretim hattında operatör hatasını azaltır ve ölçüm güvenilirliğini artırır.',
  },
  {
    title: 'CNC frezeleme projelerinde teknik resmin rolü',
    href: '/hizmetler/cnc-frezeleme/',
    image: 'assets/images/anasayfa/cnc-frezeleme.png',
    date: '27.11.2025',
    category: 'Teknik Bilgi',
    summary: 'Tolerans, yüzey kalitesi, malzeme ve kritik ölçüler doğru belirtildiğinde üretim süreci daha hızlı ve net ilerler.',
  },
  {
    title: 'Tel erozyon hangi parçalar için uygundur?',
    href: '/makina-parkuru/sodick-vl400q/',
    image: 'assets/images/anasayfa/tel-erozyon.png',
    date: '25.11.2025',
    category: 'Makina Parkuru',
    summary: 'Sert malzemeler, dar kanallar, hassas profiller ve geleneksel yöntemlerle zor işlenen geometriler için tel erozyonun avantajları.',
  },
];
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <section class="news-hero">
    <div class="hero-image">
      <OptimizedImage alt="TARGET MAKİNA haberler ve üretim gündemi" src="assets/images/haberler/news_banner.png" loading="eager" />
    </div>
    <div class="hero-overlay"></div>
    <div class="container hero-content">
      <p class="breadcrumb"><a href="/">Ana Sayfa</a> / Haberler</p>
      <h1>Haberler ve Üretim Gündemi</h1>
      <p>CNC işleme, hassas üretim, yüzey işlemleri ve sektörel uygulamalar hakkında güncel yazılar ve teknik notlar.</p>
    </div>
  </section>

  <section class="featured-section">
    <div class="container featured-card">
      <a class="featured-image" href={featured.href}>
        <OptimizedImage alt={featured.title} src={featured.image} />
      </a>
      <div class="featured-copy">
        <span>{featured.category}</span>
        <time datetime="2025-12-05">{featured.date}</time>
        <h2><a href={featured.href}>{featured.title}</a></h2>
        <p>{featured.summary}</p>
        <a class="read-more" href={featured.href}>Devamını Oku</a>
      </div>
    </div>
  </section>

  <section class="news-section">
    <div class="container">
      <div class="section-head">
        <span>Son Yazılar</span>
        <h2>Teknik bilgi ve uygulama örnekleri</h2>
      </div>
      <div class="news-grid">
        {news.map((item) => (
          <article class="news-card">
            <a class="image-link" href={item.href}>
              <OptimizedImage alt={item.title} src={item.image} />
            </a>
            <div class="card-body">
              <div class="meta">
                <span>{item.category}</span>
                <time>{item.date}</time>
              </div>
              <h3><a href={item.href}>{item.title}</a></h3>
              <p>{item.summary}</p>
              <a class="read-more" href={item.href}>İncele</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .news-hero{position:relative;min-height:380px;display:flex;align-items:center;background:linear-gradient(135deg,#7f1f0d 0%,#C93715 58%,#e04a28 100%);overflow:hidden}
  .hero-image{position:absolute;inset:0}
  .hero-image img{width:100%;height:100%;object-fit:cover;opacity:.2;filter:saturate(.9) contrast(1.08);mix-blend-mode:multiply}
  .hero-image :global(img){width:100%;height:100%;object-fit:cover;opacity:.2;filter:saturate(.9) contrast(1.08);mix-blend-mode:multiply}
  .hero-overlay{position:absolute;inset:0;background:linear-gradient(90deg,rgba(92,18,7,.98),rgba(201,55,21,.9),rgba(201,55,21,.7))}
  .hero-content{position:relative;color:#fff;max-width:760px;text-shadow:0 2px 16px rgba(0,0,0,.22)}
  .breadcrumb{font-size:14px;margin-bottom:18px;color:rgba(255,255,255,.86)}
  .breadcrumb a{color:#fff;text-decoration:none}
  .news-hero h1{font-size:44px;line-height:1.15;margin:0 0 16px;font-weight:800;color:#fff}
  .news-hero p:not(.breadcrumb){font-size:18px;line-height:1.7;margin:0;color:rgba(255,255,255,.94);max-width:680px}
  .featured-section{padding:70px 0 32px;background:#fff}
  .featured-card{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(320px,.95fr);gap:36px;align-items:center}
  .featured-image{display:block;border-radius:8px;overflow:hidden;box-shadow:0 16px 40px rgba(0,0,0,.12);aspect-ratio:16/10;background:#f2f2f2}
  .featured-image img{width:100%;height:100%;object-fit:cover;display:block}
  .featured-copy span,.section-head span{display:inline-block;color:#C93715;font-size:13px;font-weight:800;letter-spacing:1.2px;text-transform:uppercase;margin-right:12px}
  .featured-copy time{color:#777;font-size:14px}
  .featured-copy h2{font-size:34px;line-height:1.25;margin:16px 0 14px;color:#1a1a1a}
  .featured-copy h2 a,.news-card h3 a{color:inherit;text-decoration:none}
  .featured-copy p{color:#555;line-height:1.75;margin:0 0 20px}
  .read-more{color:#C93715;font-weight:800;text-decoration:none}
  .read-more:hover{text-decoration:underline}
  .news-section{padding:44px 0 82px;background:#f7f7f7}
  .section-head{text-align:center;margin:0 auto 34px;max-width:680px}
  .section-head h2{font-size:32px;line-height:1.25;margin:10px 0 0;color:#1a1a1a}
  .news-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
  .news-card{background:#fff;border:1px solid #e8e8e8;border-radius:8px;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 8px 24px rgba(0,0,0,.05)}
  .image-link{display:block;aspect-ratio:16/10;background:#eee;overflow:hidden}
  .image-link img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .25s}
  .news-card:hover .image-link img{transform:scale(1.04)}
  .card-body{padding:22px;display:flex;flex-direction:column;flex:1}
  .meta{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:12px;color:#777;font-size:13px}
  .meta span{color:#C93715;font-weight:800}
  .news-card h3{font-size:20px;line-height:1.35;margin:0 0 12px;color:#1a1a1a}
  .news-card p{color:#555;line-height:1.65;font-size:15px;margin:0 0 18px}
  .news-card .read-more{margin-top:auto}
  @media (max-width: 920px){
    .featured-card,.news-grid{grid-template-columns:1fr 1fr}
    .news-hero h1{font-size:34px}
  }
  @media (max-width: 640px){
    .featured-card,.news-grid{grid-template-columns:1fr}
    .news-hero{min-height:340px}
    .news-hero h1{font-size:30px}
    .featured-copy h2{font-size:26px}
  }
</style>
