---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Sıkça Sorulan Sorular | TARGET MAKİNA";
const description = "Target Makina CNC işleme, tolerans, teklif, teslimat, malzeme, kalite kontrol ve ödeme süreçleri hakkında sıkça sorulan sorular.";
const keywords = "CNC işleme SSS, Target Makina sorular, CNC toleransları, teknik dosya, teklif alma, hassas talaşlı imalat";

const groups = [
  {
    title: 'Yetenekler ve CNC İşleme',
    items: [
      ['Hangi tolerans aralıklarında çalışabiliyorsunuz?', 'CNC frezeleme, tornalama ve tel erozyon işlemlerinde parça geometrisine göre dar toleranslarda çalışabiliyoruz. Kritik ölçüler için teknik resim üzerinden ayrıca değerlendirme yapıyoruz.'],
      ['Hangi metal malzemeleri işleyebilirsiniz?', 'Alüminyum, paslanmaz çelik, karbon çeliği, alaşımlı çelikler, pirinç, bakır, bronz, titanyum ve benzeri teknik malzemeleri işleyebiliyoruz.'],
      ['Plastik malzeme işliyor musunuz?', 'Evet. ABS, POM, PA, PC, PMMA, PE, PTFE, PEEK ve benzeri mühendislik plastikleri için CNC işleme hizmeti sunuyoruz.'],
      ['Yüzey işlemi desteğiniz var mı?', 'Eloksal, kumlama, polisaj, kaplama, karartma ve boya gibi yüzey işlemlerinde proje ihtiyacına göre çözüm sunuyoruz.'],
    ],
  },
  {
    title: 'Sipariş ve Teknik Destek',
    items: [
      ['Minimum sipariş miktarınız nedir?', 'Minimum sipariş sınırımız yoktur. Tek adet prototipten seri üretime kadar farklı adetlerde çalışabiliriz.'],
      ['Teklif almak için hangi dosyalar gerekir?', 'STEP, STP, IGES, STL, DXF, DWG veya PDF teknik resim dosyalarıyla teklif alabilirsiniz. Numune parça üzerinden de değerlendirme yapılabilir.'],
      ['Üretilebilirlik konusunda destek veriyor musunuz?', 'Evet. Tasarımın üretime uygunluğu, tolerans gereksinimleri, bağlama yöntemi ve malzeme seçimi konusunda teknik öneriler sunabiliriz.'],
      ['Gizlilik sözleşmesi imzalıyor musunuz?', 'Evet. Proje ve teknik çizimleriniz için talep edildiğinde gizlilik sözleşmesi imzalayabiliriz.'],
    ],
  },
  {
    title: 'Üretim Süreci',
    items: [
      ['Teslim süresi nasıl belirlenir?', 'Teslim süresi parça geometrisi, malzeme, adet, yüzey işlemi ve kalite kontrol gereksinimlerine göre belirlenir. Prototip işlerde süreç genellikle daha kısa ilerler.'],
      ['Kalite kontrol nasıl yapılıyor?', 'Kritik ölçüler kumpas, mikrometre, mastar ve CMM gibi ölçüm ekipmanlarıyla kontrol edilir. Gerektiğinde ölçüm raporu hazırlanabilir.'],
      ['Mastar ve fikstür tasarlayabiliyor musunuz?', 'Evet. Kalite kontrol mastarı, bağlama fikstürü, kaynak fikstürü ve montaj aparatı gibi özel çözümler tasarlayıp üretebiliyoruz.'],
    ],
  },
  {
    title: 'Ödeme ve Sevkiyat',
    items: [
      ['Ödeme koşulları nelerdir?', 'Ödeme koşulları proje kapsamına ve müşteri çalışma modeline göre netleştirilir. Yeni projelerde genellikle sipariş onayı ve teslimat aşamalarına göre planlama yapılır.'],
      ['Türkiye geneline gönderim yapıyor musunuz?', 'Evet. İzmir dışındaki siparişler uygun paketleme ile anlaşmalı kargo veya lojistik kanalları üzerinden gönderilebilir.'],
      ['Parçalar nasıl paketleniyor?', 'Üretimi tamamlanan parçalar yüzey ve hassas ölçüler korunacak şekilde paketlenir. Gerektiğinde özel koruyucu ambalaj uygulanır.'],
    ],
  },
];
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <section class="faq-hero">
    <div class="container">
      <p><a href="/">Ana Sayfa</a> / SSS</p>
      <h1>Sıkça Sorulan Sorular</h1>
      <span>CNC işleme, teklif, üretim, kalite kontrol ve teslimat süreçleri hakkında merak edilenler.</span>
      <a class="hero-action quote-trigger" href="#teklif">Teklif Al</a>
    </div>
  </section>

  <section class="quick-stats">
    <div class="container stats-grid">
      <div><strong>24 saat</strong><span>içinde teklif hedefi</span></div>
      <div><strong>DFM</strong><span>üretilebilirlik desteği</span></div>
      <div><strong>CMM</strong><span>ölçüm kontrolü</span></div>
      <div><strong>1+ adet</strong><span>prototip ve seri üretim</span></div>
    </div>
  </section>

  <section class="faq-section">
    <div class="container">
      <div class="section-head">
        <span>Bilgi Merkezi</span>
        <h2>Aradığınız yanıtı hızlıca bulun</h2>
      </div>
      <div class="faq-layout">
        {groups.map((group) => (
          <div class="faq-group">
            <h3>{group.title}</h3>
            <div class="question-list">
              {group.items.map(([question, answer], index) => (
                <details open={index === 0}>
                  <summary>{question}</summary>
                  <p>{answer}</p>
                </details>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="question-cta">
    <div class="container">
      <h2>Başka bir sorunuz mu var?</h2>
      <p>Teknik çiziminiz, malzeme seçiminiz veya teslim süreniz hakkında netleşmeyen bir konu varsa bizimle iletişime geçebilirsiniz.</p>
      <a href="/iletisim/">İletişime Geçin</a>
    </div>
  </section>
</BaseLayout>

<style>
  .faq-hero{background:linear-gradient(135deg,#171717,#2a2a2a);color:#fff;padding:92px 0;border-bottom:5px solid #C93715}
  .faq-hero p{font-size:14px;margin:0 0 16px;color:rgba(255,255,255,.72)}
  .faq-hero p a{color:#fff;text-decoration:none}
  .faq-hero h1{font-size:46px;line-height:1.15;margin:0 0 14px;font-weight:800}
  .faq-hero span{display:block;font-size:18px;line-height:1.7;max-width:720px;color:rgba(255,255,255,.9);margin-bottom:26px}
  .hero-action{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 26px;border-radius:6px;background:#C93715;color:#fff;font-weight:800;text-decoration:none}
  .hero-action:hover{background:#a92f13;color:#fff}
  .quick-stats{background:#171717;color:#fff;padding:28px 0}
  .stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
  .stats-grid div{border-left:3px solid #C93715;padding-left:16px}
  .stats-grid strong{display:block;font-size:22px;margin-bottom:4px}
  .stats-grid span{color:#bbb;font-size:14px}
  .faq-section{background:#f7f7f7;padding:76px 0}
  .section-head{text-align:center;margin:0 auto 36px;max-width:720px}
  .section-head span{display:inline-block;color:#C93715;font-size:13px;font-weight:800;letter-spacing:1.2px;text-transform:uppercase;margin-bottom:12px}
  .section-head h2{font-size:34px;line-height:1.25;margin:0;color:#1a1a1a}
  .faq-layout{display:grid;grid-template-columns:repeat(2,1fr);gap:26px}
  .faq-group{background:#fff;border:1px solid #e8e8e8;border-radius:8px;padding:26px;box-shadow:0 8px 24px rgba(0,0,0,.05)}
  .faq-group h3{font-size:22px;color:#1a1a1a;margin:0 0 18px}
  .question-list{display:grid;gap:12px}
  details{border:1px solid #e6e6e6;border-radius:8px;background:#fff;overflow:hidden}
  summary{cursor:pointer;list-style:none;padding:18px 46px 18px 18px;color:#1a1a1a;font-weight:800;position:relative;line-height:1.45}
  summary::-webkit-details-marker{display:none}
  summary::after{content:'+';position:absolute;right:18px;top:50%;transform:translateY(-50%);color:#C93715;font-size:22px;font-weight:800}
  details[open] summary{border-bottom:1px solid #eee;background:#fff7f4}
  details[open] summary::after{content:'-'}
  details p{padding:18px;margin:0;color:#444;background:#fff;line-height:1.75;font-size:15px}
  .question-cta{background:#C93715;color:#fff;text-align:center;padding:66px 0}
  .question-cta h2{font-size:32px;line-height:1.25;margin:0 0 12px}
  .question-cta p{max-width:720px;margin:0 auto 24px;line-height:1.7;color:rgba(255,255,255,.92)}
  .question-cta a{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 26px;border-radius:6px;background:#fff;color:#C93715;font-weight:800;text-decoration:none}
  .question-cta a:hover{background:#171717;color:#fff}
  @media (max-width: 900px){
    .stats-grid,.faq-layout{grid-template-columns:1fr 1fr}
    .faq-hero h1{font-size:36px}
  }
  @media (max-width: 640px){
    .stats-grid,.faq-layout{grid-template-columns:1fr}
    .faq-hero{padding:70px 0}
    .faq-hero h1{font-size:30px}
  }
</style>
