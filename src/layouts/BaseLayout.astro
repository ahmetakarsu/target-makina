---
export interface Props {
  title: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  canonical?: string;
  robots?: string;
}

const {
  title,
  description = 'TARGET MAKİNA - İzmir merkezli CNC frezeleme, CNC tornalama, hassas işleme ve yüzey kaplama hizmetleri.',
  keywords = 'CNC işleme, CNC frezeleme, CNC tornalama, hassas üretim, Target Makina, İzmir CNC',
  ogImage,
  canonical,
  robots = 'index, follow',
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://targetmakina.com.tr');
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).toString();

import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';
import QuotePopup from '../components/QuotePopup.astro';
---

<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="keywords" content={keywords}>
  <meta name="robots" content={robots}>
  <link rel="shortcut icon" href="/favicon.ico">
  <link rel="canonical" href={canonicalUrl}>

  <!-- Open Graph -->
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:locale" content="tr_TR">
  <meta property="og:site_name" content="TARGET MAKİNA">
  <meta property="og:url" content={canonicalUrl}>
  {ogImage && <meta property="og:image" content={ogImage}>}

  <!-- Preload font -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap">
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
  <noscript>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  </noscript>

  <!-- Original CSS files -->
  <link rel="stylesheet" href="/assets/tpl-common/common/css/iconfont.css">
  <link rel="stylesheet" href="/assets/tpl-common/common/css/animate.css" media="screen and (min-width: 768px)">
  
  <slot name="head" />
</head>
<body class="bg-white text-dark-muted antialiased overflow-x-hidden">
  <Header />

  <main>
    <slot />
  </main>

  <Footer />
  <Sidebar />
  <QuotePopup />

  <!-- Original JS files -->
  <script is:inline src="/assets/tpl-common/common/js/jquery.js" defer></script>
  <script is:inline src="/assets/tpl-common/common/js/popper.min.js" defer></script>
  <script is:inline src="/assets/tpl-common/common/js/bootstrap.min.js" defer></script>
  <script is:inline src="/assets/tpl-common/common/js/wow.js" defer></script>
  <script is:inline src="/assets/tpl-common/common/js/swiper7.js" defer></script>
  <script is:inline src="/assets/tpl-common/common/js/jquery.counterup.js" defer></script>
  <script is:inline src="/assets/tpl-common/common/js/jquery.fancybox.js" defer></script>
  <script is:inline src="/assets/tpl-common/common/js/form.js" defer></script>
  <script is:inline src="/assets/tpl-common/common/js/bootstrap-select.min.js" defer></script>

  <slot name="scripts" />
</body>
</html>
