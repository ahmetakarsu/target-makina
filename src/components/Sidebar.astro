  <button id="sidebar-quote-btn" type="button" aria-label="Teklif Al" class="contact-action contact-action-quote">
    <svg class="contact-action-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
  </button>
</div>

<style>
  .contact-actions {
    position: fixed;
    right: 0;
    top: 50%;
    z-index: 40;
    display: flex;
    flex-direction: column;
    gap: 6px;
    transform: translateY(-50%);
  }

  .contact-action {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    color: #fff;
    border: 0;
    border-radius: 8px 0 0 8px;
    box-shadow: 0 10px 25px rgba(16, 24, 40, 0.16);
    transition: transform 0.2s ease, filter 0.2s ease;
  }

  .contact-action:hover {
    color: #fff;
    filter: brightness(0.95);
    transform: translateX(-3px);
  }

  .contact-action-icon {
    width: 20px;
    height: 20px;
  }

  .contact-action-phone { background: #c93715; }
  .contact-action-whatsapp { background: #22c55e; }
  .contact-action-mail { background: #2563eb; }
  .contact-action-quote { background: #f97316; cursor: pointer; }

  @media (max-width: 767px) {
    .contact-actions {
      left: 50%;
      right: auto;
      top: auto;
      bottom: calc(14px + env(safe-area-inset-bottom));
      flex-direction: row;
      padding: 8px;
      border: 1px solid rgba(232, 237, 242, 0.9);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.94);
      box-shadow: 0 18px 45px rgba(16, 24, 40, 0.18);
      transform: translateX(-50%);
      backdrop-filter: blur(10px);
    }

    .contact-action {
      width: 46px;
      height: 46px;
      border-radius: 50%;
    }

    .contact-action:hover {
      transform: translateY(-2px);
    }
  }
</style>
