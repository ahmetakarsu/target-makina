---
const currentPath = Astro.url.pathname;

const navItems = [
  { label: 'Ana Sayfa', href: '/' },
  {
    label: 'Hizmetler', href: '/hizmetler/',
    children: [
      { label: 'CNC Frezeleme', href: '/hizmetler/cnc-frezeleme/' },
      { label: 'CNC Tornalama', href: '/hizmetler/cnc-tornalama/' },
      { label: '5 Eksen CNC İşleme', href: '/hizmetler/5-eksen-cnc/' },
      { label: 'Yüzey İşleme', href: '/hizmetler/yuzey-isleme/' },
      { label: 'Mastar & Fikstür İmalatı', href: '/hizmetler/mastar-fikstur/' },
      { label: 'Hassas Talaşlı İmalat', href: '/hizmetler/hassas-talasli-imalat/' },
      { label: 'Parça Montajı', href: '/hizmetler/parca-montaji/' },
      { label: 'Sac Şekillendirme', href: '/hizmetler/sac-sekillendirme/' },
      { label: 'Dişli İmalatı', href: '/hizmetler/disli-imalati/' },
    ],
  },
  { label: 'Kaynaklar', href: '/kaynaklar/' },
  { label: 'Haberler', href: '/haberler/' },
  { label: 'Makina Parkuru', href: '/makina-parkuru/' },
  { label: 'Hakkımızda', href: '/hakkimizda/' },
  { label: 'İletişim', href: '/iletisim/' },
];
---

<header class="w-full z-50 relative">
  <div class="bg-dark text-white text-sm hidden md:block">
    <div class="max-w-7xl mx-auto px-4 flex justify-between items-center h-10">
      <div class="flex items-center gap-6">
        <a href="mailto:info@targetmakina.com.tr" class="hover:text-primary transition-colors flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          info@targetmakina.com.tr
        </a>
        <a href="tel:905443563972" class="hover:text-primary transition-colors flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          0544 356 39 72
        </a>
      </div>
      <div class="flex items-center gap-3">
        <a href="https://www.instagram.com/halil_senturk35/?hl=tr" target="_blank" rel="nofollow noopener" aria-label="Instagram" class="hover:text-primary transition-colors">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
        </a>
        <a href="https://www.facebook.com/halil.senturk.545195" target="_blank" rel="nofollow noopener" aria-label="Facebook" class="hover:text-primary transition-colors">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </a>
      </div>
    </div>
  </div>

  <nav class="bg-white shadow-md sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 flex items-center justify-between h-16 lg:h-20">
      <a href="/" class="flex-shrink-0">
        <img src="/images/target-makina-logo.png" alt="TARGET MAKİNA" class="h-10 lg:h-12 w-auto" loading="eager">
      </a>

      <ul class="hidden lg:flex items-center gap-1">
        {navItems.map((item) => (
          <li class:list={['relative', item.children ? 'nav-dropdown group' : ''] } data-nav-dropdown={item.children ? '' : undefined}>
            {item.children ? (
              <>
                <button
                  type="button"
                  data-nav-toggle
                  aria-expanded="false"
                  class:list={[
                    'px-3 py-2 text-sm font-medium rounded-md transition-colors inline-flex items-center gap-1',
                    currentPath === item.href || currentPath.startsWith(item.href) ? 'text-primary' : 'text-dark hover:text-primary',
                  ]}
                >
                  {item.label}
                  <svg class="w-3 h-3 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </button>
                <ul class="nav-dropdown-panel absolute left-0 top-full mt-0 w-72 bg-white shadow-xl rounded-lg py-2 transition-all duration-200 z-50 border border-gray-100">
                  <li>
                    <a href={item.href} class="block px-4 py-2 text-sm font-semibold text-primary hover:bg-primary-light transition-colors">
                      Tüm Hizmetler
                    </a>
                  </li>
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href} class="block px-4 py-2 text-sm text-dark-muted hover:text-primary hover:bg-primary-light transition-colors">
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            ) : (
              <a
                href={item.href}
                class:list={[
                  'px-3 py-2 text-sm font-medium rounded-md transition-colors',
                  currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href)) ? 'text-primary' : 'text-dark hover:text-primary',
                ]}
              >
                {item.label}
              </a>
            )}
          </li>
        ))}
      </ul>

      <div class="flex items-center gap-3">
        <a href="#teklif" class="quote-trigger hidden sm:inline-flex items-center px-5 py-2.5 bg-primary text-white text-sm font-semibold rounded-lg hover:bg-primary-hover transition-colors">
          Teklif Al
        </a>
        <button id="mobile-toggle" class="lg:hidden p-2 text-dark" aria-label="Menüyü aç" aria-expanded="false">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="lg:hidden hidden bg-white border-t border-gray-100 shadow-lg">
      <div class="px-4 py-4 space-y-1">
        {navItems.map((item) => (
          <div>
            <a href={item.href} class="block px-3 py-2.5 text-sm font-medium text-dark hover:text-primary hover:bg-primary-light rounded-md transition-colors">
              {item.label}
            </a>
            {item.children && (
              <div class="pl-6 space-y-1">
                {item.children.map((child) => (
                  <a href={child.href} class="block px-3 py-2 text-sm text-dark-muted hover:text-primary transition-colors">
                    {child.label}
                  </a>
                ))}
              </div>
            )}
          </div>
        ))}
        <a href="#teklif" class="quote-trigger block w-full text-center px-5 py-2.5 bg-primary text-white text-sm font-semibold rounded-lg hover:bg-primary-hover transition-colors mt-3">
          Teklif Al
        </a>
      </div>
    </div>
  </nav>
</header>

<style>
  @media (min-width: 1024px) {
    .nav-dropdown-panel {
      opacity: 0;
      visibility: hidden !important;
      pointer-events: none;
      transform: translateY(8px);
    }

    .nav-dropdown:hover .nav-dropdown-panel,
    .nav-dropdown:focus-within .nav-dropdown-panel,
    .nav-dropdown.is-open .nav-dropdown-panel {
      opacity: 1;
      visibility: visible !important;
      pointer-events: auto;
      transform: translateY(0);
    }

    .nav-dropdown.is-open [data-nav-toggle] svg,
    .nav-dropdown:hover [data-nav-toggle] svg,
    .nav-dropdown:focus-within [data-nav-toggle] svg {
      transform: rotate(180deg);
    }
  }
</style>

<script>
  const toggle = document.getElementById('mobile-toggle');
  const menu = document.getElementById('mobile-menu');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });

  const dropdowns = document.querySelectorAll('[data-nav-dropdown]');
  const closeDropdowns = (except?: Element) => {
    dropdowns.forEach((dropdown) => {
      if (dropdown === except) return;
      dropdown.classList.remove('is-open');
      dropdown.querySelector('[data-nav-toggle]')?.setAttribute('aria-expanded', 'false');
    });
  };

  dropdowns.forEach((dropdown) => {
    const navToggle = dropdown.querySelector('[data-nav-toggle]');

    navToggle?.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopPropagation();
      const shouldOpen = !dropdown.classList.contains('is-open');
      closeDropdowns(dropdown);
      dropdown.classList.toggle('is-open', shouldOpen);
      navToggle.setAttribute('aria-expanded', String(shouldOpen));
    });

    dropdown.addEventListener('keydown', (event) => {
      if (event instanceof KeyboardEvent && event.key === 'Escape') {
        dropdown.classList.remove('is-open');
        navToggle?.setAttribute('aria-expanded', 'false');
      }
    });
  });

  document.addEventListener('click', () => closeDropdowns());
</script>
